{
  "name": "tmp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "npm run db:start && npm run dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/seed-test-users.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:desktop": "playwright test --config=e2e/playwright.config.ts --project=desktop",
    "test:e2e:mobile": "playwright test --config=e2e/playwright.config.ts --project=mobile",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:auth": "playwright test --config=e2e/playwright.config.ts specs/auth",
    "test:e2e:report": "playwright show-report e2e/test-results/report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@supabase/cli": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
